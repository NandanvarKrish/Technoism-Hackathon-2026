{
  "name": "tech-titans",
  "version": "1.0.0",
  "description": "Fully Functional AI-Powered Interview Preparation Web Application",
  "main": "server/server.js",
  "scripts": {
    "start": "node server/server.js",
    "server": "node server/server.js",
    "client": "npm --prefix client run dev",
