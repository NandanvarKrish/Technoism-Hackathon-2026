# TECH TITANS — Environment Variables Template
# Copy this file to .env and fill in real credentials

# Express Server Port Configuration
PORT=5000

# Google Gemini API Studio Credentials (Server-side only)
GEMINI_API_KEY=your_gemini_api_key_here

# Supabase SQL Database Credentials (Server-side only)
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Code Execution Sandbox Service Credentials (Server-side only)
CODE_EXECUTION_URL=https://code-execution-sandbox.example.com
CODE_EXECUTION_KEY=your_code_execution_api_key_here
